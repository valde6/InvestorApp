<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Oversigt - <%= sagen.navn %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <a href="/ejendomsprofiler/<%= ejendomsprofil_id %>">← Tilbage til ejendom</a>
        <h1>
            <%= sagen.navn %>
        </h1>
        <% if (sagen.beskrivelse) { %>
            <p>
                <%= sagen.beskrivelse %>
            </p>
            <% } %>
    </header>

    <main>

        <section>
            <h2>Køb og renoveringsudgifter</h2>
            <div class="ejendom-data">
                <p><strong>Ejendomspris:</strong>
                    <%= Number(sagen.ejendomspris).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Omkostninger ved køb:</strong>
                    <%= Number(sagen.omkostninger_koeb).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Advokat:</strong>
                    <%= Number(sagen.advokat).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Tinglysning:</strong>
                    <%= Number(sagen.tinglysning).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Køberrådgivning:</strong>
                    <%= Number(sagen.koeberraadgivning).toLocaleString('da-DK') %> kr.
                </p>
            </div>
            <% if (koebsomkostninger.length> 0) { %>
                <h3 style="margin-top: 1rem; font-size: 0.95rem; color: #555;">Ekstra udgifter</h3>
                <div class="ejendom-data">
                    <% koebsomkostninger.forEach(k=> { %>
                        <p><strong>
                                <%= k.beskrivelse %>:
                            </strong>
                            <%= Number(k.beloeb).toLocaleString('da-DK') %> kr.
                        </p>
                        <% }) %>
                </div>
                <% } %>
        </section>

        <section>
            <h2>Finansiering</h2>
            <% if (finansiering) { %>
                <div class="ejendom-data">
                    <p><strong>Lånebeløb:</strong>
                        <%= Number(finansiering.laanebeloeb).toLocaleString('da-DK') %> kr.
                    </p>
                    <p><strong>Rente:</strong>
                        <%= finansiering.rente_procent %> %
                    </p>
                    <p><strong>Løbetid:</strong>
                        <%= finansiering.loebetid_aar %> år
                    </p>
                    <p><strong>Afdragsfri periode:</strong>
                        <%= finansiering.afdragsfri_periode_aar %> år
                    </p>
                    <p><strong>Lånetype:</strong>
                        <%= finansiering.laanetype %>
                    </p>
                </div>
                <% } %>
        </section>

        <section>
            <h2>Driftsomkostninger</h2>
            <% if (driftsomkostninger.length> 0) { %>
                <div class="ejendom-data">
                    <% driftsomkostninger.forEach(d=> { %>
                        <p><strong>
                                <%= d.beskrivelse %>:
                            </strong>
                            <%= Number(d.maanedlig_beloeb).toLocaleString('da-DK') %> kr./md.
                        </p>
                        <% }) %>
                </div>
                <% } else { %>
                    <p style="color: #888;">Ingen driftsomkostninger angivet.</p>
                    <% } %>
        </section>

        <section>
            <h2>Udlejning</h2>
            <% if (udlejninger.length> 0) { %>
                <div class="ejendom-data">
                    <% udlejninger.forEach(u=> { %>
                        <p><strong>
                                <%= u.beskrivelse %>:
                            </strong>
                            <%= Number(u.maanedlig_leje).toLocaleString('da-DK') %> kr./md. (udgifter: <%=
                                    Number(u.udlejningsomkostning).toLocaleString('da-DK') %> kr./md.)
                        </p>
                        <% }) %>
                </div>
                <% } else { %>
                    <p style="color: #888;">Ingen udlejning angivet.</p>
                    <% } %>
        </section>

        <section>
            <h2>Simulering (30 år)</h2>
            <div style="position: relative; width: 100%;">
                <canvas id="simuleringChart"></canvas>
            </div>
            <div style="overflow-x: auto;">
                <table class="simulering-tabel">
                    <thead>
                        <tr>
                            <th>År</th>
                            <th>Cashflow (kr.)</th>
                            <th>Gæld (kr.)</th>
                            <th>Egenkapital (kr.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% simulering.forEach(s=> { %>
                            <tr>
                                <td>
                                    <%= s.aar %>
                                </td>
                                <td class="<%= s.cashflow < 0 ? 'tal-negativ' : 'tal-positiv' %>">
                                    <%= s.cashflow.toLocaleString('da-DK') %>
                                </td>
                                <td>
                                    <%= s.gaeld.toLocaleString('da-DK') %>
                                </td>
                                <td>
                                    <%= s.egenkapital.toLocaleString('da-DK') %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
    
    <!-- Chart.js er et JavaScript-bibliotek til at lave diagrammer.
     I stedet for at have biblioteket liggende i projektet selv,
     hentes det fra Cloudflares CDN — et globalt netværk af servere
     der leverer filen hurtigt uanset hvor brugeren befinder sig. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

    <script>
        // Henter simuleringsdata direkte fra serveren via EJS.
        // <%- %> indsætter værdien uden HTML-escaping, så JSON forbliver valid JavaScript.
        // VS Code markerer linjen som en fejl da editoren ikke forstår EJS-syntaks i JavaScript,
        // men koden er korrekt og virker uden problemer i browseren.
        const simData = <%- JSON.stringify(simulering) %>;

        // Lav labels til x-aksen — ét label per år (fx "År 1", "År 2" osv.)
        const labels = simData.map(s => 'År ' + s.aar);

        // Opret et nyt linjediagram i canvas-elementet
        new Chart(document.getElementById('simuleringChart').getContext('2d'), {
            type: 'line',
            data: {
                labels,
                datasets: [
                    // Cashflow — grøn linje
                    { label: 'Cashflow (kr.)', data: simData.map(s => s.cashflow), borderColor: '#2a7a3b', backgroundColor: 'rgba(42,122,59,0.08)', tension: 0.3 },
                    // Gæld — rød linje
                    { label: 'Gæld (kr.)', data: simData.map(s => s.gaeld), borderColor: '#c0392b', backgroundColor: 'rgba(192,57,43,0.08)', tension: 0.3 },
                    // Egenkapital — blå linje
                    { label: 'Egenkapital (kr.)', data: simData.map(s => s.egenkapital), borderColor: '#2a5caa', backgroundColor: 'rgba(42,92,170,0.08)', tension: 0.3 }
                ]
            },
            options: {
                responsive: true,        // Grafen tilpasser sig vinduets bredde
                maintainAspectRatio: true,
                plugins: { legend: { position: 'top' } }, // Forklaring vises øverst
                scales: {
                    y: {
                        ticks: {
                            // Formatér y-aksens tal med dansk tusindtalsseparator og kr. suffix
                            callback: v => v.toLocaleString('da-DK') + ' kr.'
                        }
                    }
                }
            }
        });
    </script>
</body>

</html>