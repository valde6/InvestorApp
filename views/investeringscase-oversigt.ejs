<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Oversigt - <%= sagen.navn %>
    </title>
</head>

<body>
    <!-- Link tilbage til den ejendomsprofil som denne case tilhører -->
    <a href="/ejendomsprofiler/<%= ejendomsprofil_id %>">← Tilbage til ejendom</a>
    <h1>
        <%= sagen.navn %>
    </h1>
    <p>
        <%= sagen.beskrivelse %>
    </p>

    <h2>Køb og renoveringsudgifter</h2>
    <p>Ejendomspris: <%= sagen.ejendomspris %> kr.</p>
    <p>Omkostninger ved køb: <%= sagen.omkostninger_koeb %> kr.</p>
    <p>Advokat: <%= sagen.advokat %> kr.</p>
    <p>Tinglysning: <%= sagen.tinglysning %> kr.</p>
    <p>Køberrådgivning: <%= sagen.koeberraadgivning %> kr.</p>

    <% if (koebsomkostninger.length> 0) { %>
        <h3>Ekstra udgifter</h3>
        <% koebsomkostninger.forEach(k=> { %>
            <p>
                <%= k.beskrivelse %>: <%= k.beloeb %> kr.
            </p>
            <% }) %>
                <% } %>

                    <h2>Finansiering</h2>
                    <% if (finansiering) { %>
                        <p>Lånebeløb: <%= finansiering.laanebeloeb %> kr.</p>
                        <p>Rente: <%= finansiering.rente_procent %> %</p>
                        <p>Løbetid: <%= finansiering.loebetid_aar %> år</p>
                        <p>Afdragsfri periode: <%= finansiering.afdragsfri_periode_aar %> år</p>
                        <p>Lånetype: <%= finansiering.laanetype %>
                        </p>
                        <% } %>

                            <h2>Driftsomkostninger</h2>
                            <% if (driftsomkostninger.length> 0) { %>
                                <% driftsomkostninger.forEach(d=> { %>
                                    <p>
                                        <%= d.beskrivelse %>: <%= d.maanedlig_beloeb %> kr./md.
                                    </p>
                                    <% }) %>
                                        <% } else { %>
                                            <p>Ingen driftsomkostninger angivet.</p>
                                            <% } %>

                                                <h2>Udlejning</h2>
                                                <% if (udlejninger.length> 0) { %>
                                                    <% udlejninger.forEach(u=> { %>
                                                        <p>
                                                            <%= u.beskrivelse %>: <%= u.maanedlig_leje %> kr./md.
                                                                    (udgifter: <%= u.udlejningsomkostning %> kr./md.)
                                                        </p>
                                                        <% }) %>
                                                            <% } else { %>
                                                                <p>Ingen udlejning angivet.</p>
                                                                <% } %>


                                                                    <h2>Simulering (30 år)</h2>
                                                                    <table>
                                                                        <thead>
                                                                            <tr>
                                                                                <th>År</th>
                                                                                <th>Cashflow (kr.)</th>
                                                                                <th>Gæld (kr.)</th>
                                                                                <th>Egenkapital (kr.)</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            <% simulering.forEach(s=> { %>
                                                                                <tr>
                                                                                    <td>
                                                                                        <%= s.aar %>
                                                                                    </td>
                                                                                    <td>
                                                                                        <%= s.cashflow.toLocaleString('da-DK')
                                                                                            %>
                                                                                    </td>
                                                                                    <td>
                                                                                        <%= s.gaeld.toLocaleString('da-DK')
                                                                                            %>
                                                                                    </td>
                                                                                    <td>
                                                                                        <%= s.egenkapital.toLocaleString('da-DK')
                                                                                            %>
                                                                                    </td>
                                                                                </tr>
                                                                                <% }) %>
                                                                        </tbody>
                                                                    </table>

                                                                    <!-- Chart.js fra CDN -->
                                                                    <script
                                                                        src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

                                                                    <h2>Simulering (30 år)</h2>
                                                                    <canvas id="simuleringChart" width="900"
                                                                        height="400"></canvas>

                                                                    <script>
                                                                        // Data fra serveren via EJS
                                                                        const simData = <%- JSON.stringify(simulering) %>;

                                                                        const labels = simData.map(s => 'År ' + s.aar);
                                                                        const cashflow = simData.map(s => s.cashflow);
                                                                        const gaeld = simData.map(s => s.gaeld);
                                                                        const egenkapital = simData.map(s => s.egenkapital);

                                                                        const ctx = document.getElementById('simuleringChart').getContext('2d');
                                                                        new Chart(ctx, {
                                                                            type: 'line',
                                                                            data: {
                                                                                labels: labels,
                                                                                datasets: [
                                                                                    {
                                                                                        label: 'Cashflow (kr.)',
                                                                                        data: cashflow,
                                                                                        borderColor: 'green',
                                                                                        backgroundColor: 'rgba(0,128,0,0.1)',
                                                                                        tension: 0.3
                                                                                    },
                                                                                    {
                                                                                        label: 'Gæld (kr.)',
                                                                                        data: gaeld,
                                                                                        borderColor: 'red',
                                                                                        backgroundColor: 'rgba(255,0,0,0.1)',
                                                                                        tension: 0.3
                                                                                    },
                                                                                    {
                                                                                        label: 'Egenkapital (kr.)',
                                                                                        data: egenkapital,
                                                                                        borderColor: 'blue',
                                                                                        backgroundColor: 'rgba(0,0,255,0.1)',
                                                                                        tension: 0.3
                                                                                    }
                                                                                ]
                                                                            },
                                                                            options: {
                                                                                responsive: true,
                                                                                plugins: {
                                                                                    legend: { position: 'top' },
                                                                                    title: {
                                                                                        display: true,
                                                                                        text: 'Udvikling over 30 år'
                                                                                    }
                                                                                },
                                                                                scales: {
                                                                                    y: {
                                                                                        ticks: {
                                                                                            // Formatér tal med tusindtalsseparator
                                                                                            callback: function (value) {
                                                                                                return value.toLocaleString('da-DK') + ' kr.';
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        });
                                                                    </script>

</body>

</html>