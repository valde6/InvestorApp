<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Oversigt - <%= sagen.navn %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <a href="/ejendomsprofiler/<%= ejendomsprofil_id %>">← Tilbage til ejendom</a>
        <h1>
            <%= sagen.navn %>
        </h1>
        <% if (sagen.beskrivelse) { %>
            <p>
                <%= sagen.beskrivelse %>
            </p>
            <% } %>

                <!-- Knapper til at håndtere casen - placeret i en flex-container så de står på række -->
                <div class="header-knapper">
                    <a href="/investeringscases/<%= sagen.investeringscase_id %>/rediger/koeb">
                        <button class="knap-rediger">Rediger case</button>
                    </a>

                    <!-- Dupliker sendes som POST da HTML ikke understøtter PUT direkte -->
                    <form action="/investeringscases/<%= sagen.investeringscase_id %>/dupliker" method="POST">
                        <button type="submit" class="knap-dupliker">Dupliker case</button>
                    </form>

                    <!-- Slet sendes som POST da HTML ikke understøtter DELETE direkte -->
                    <form action="/investeringscases/<%= sagen.investeringscase_id %>/slet" method="POST">
                        <button type="submit" class="knap-slet"
                            onclick="return confirm('Er du sikker på at du vil slette denne case?')">Slet case</button>
                    </form>
                </div>
    </header>

    <main>

        <section>
            <h2>Køb og renoveringsudgifter</h2>
            <div class="ejendom-data">
                <p><strong>Ejendomspris:</strong>
                    <%= Number(sagen.ejendomspris).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Omkostninger ved køb:</strong>
                    <%= Number(sagen.omkostninger_koeb).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Advokat:</strong>
                    <%= Number(sagen.advokat).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Tinglysning:</strong>
                    <%= Number(sagen.tinglysning).toLocaleString('da-DK') %> kr.
                </p>
                <p><strong>Køberrådgivning:</strong>
                    <%= Number(sagen.koeberraadgivning).toLocaleString('da-DK') %> kr.
                </p>
            </div>
            <% if (koebsomkostninger.length> 0) { %>
                <h3 style="margin-top: 1rem; font-size: 0.95rem; color: #555;">Ekstra udgifter</h3>
                <div class="ejendom-data">
                    <% koebsomkostninger.forEach(k=> { %>
                        <p><strong>
                                <%= k.beskrivelse %>:
                            </strong>
                            <%= Number(k.beloeb).toLocaleString('da-DK') %> kr.
                        </p>
                        <% }) %>
                </div>
                <% } %>
        </section>

        <section>
            <h2>Finansiering</h2>
            <% if (finansiering) { %>
                <div class="ejendom-data">
                    <p><strong>Lånebeløb:</strong>
                        <%= Number(finansiering.laanebeloeb).toLocaleString('da-DK') %> kr.
                    </p>
                    <p><strong>Rente:</strong>
                        <%= finansiering.rente_procent %> %
                    </p>
                    <p><strong>Løbetid:</strong>
                        <%= finansiering.loebetid_aar %> år
                    </p>
                    <p><strong>Afdragsfri periode:</strong>
                        <%= finansiering.afdragsfri_periode_aar %> år
                    </p>
                    <p><strong>Lånetype:</strong>
                        <%= finansiering.laanetype %>
                    </p>
                    <p><strong>Månedlig ydelse:</strong>
                        <!-- finansieringModel er JavaScript-objektet (Finansiering-klassen) der kan kalde .maanedligYdelse()
                        finansiering er rå databasedata (plain object) der kun bruges til at vise gemte værdier som rente_procent -->
                        <%= Number(finansieringModel.maanedligYdelse().toFixed(0)).toLocaleString('da-DK') %> kr./md.
                    </p>
                    <p><strong>Total renteomkostning:</strong>
                        <%= Number(finansieringModel.totalRenteomkostning().toFixed(0)).toLocaleString('da-DK') %> kr.
                    </p>
                    <p><strong>Månedlig cashflow-påvirkning fra lån:</strong>
                        -<%= Number(finansieringModel.maanedligYdelse().toFixed(0)).toLocaleString('da-DK') %> kr./md.
                    </p>
                </div>
                <% } %>
        </section>

        <section>
            <h2>Driftsomkostninger</h2>
            <% if (driftsomkostninger.length> 0) { %>
                <div class="ejendom-data">
                    <% driftsomkostninger.forEach(d=> { %>
                        <p><strong>
                                <%= d.beskrivelse %>:
                            </strong>
                            <%= Number(d.maanedlig_beloeb).toLocaleString('da-DK') %> kr./md.
                        </p>
                        <% }) %>
                </div>
                <% } else { %>
                    <p style="color: #888;">Ingen driftsomkostninger angivet.</p>
                    <% } %>
        </section>

        <section>
            <h2>Udlejning</h2>
            <% if (udlejninger.length> 0) { %>
                <div class="ejendom-data">
                    <% udlejninger.forEach(u=> { %>
                        <p><strong>
                                <%= u.beskrivelse %>:
                            </strong>
                            <%= Number(u.maanedlig_leje).toLocaleString('da-DK') %> kr./md. (udgifter: <%=
                                    Number(u.udlejningsomkostning).toLocaleString('da-DK') %> kr./md.)
                        </p>
                        <p><strong>Månedlig nettolejeindtægt:</strong>
                            <%= Number(u.maanedlig_leje - u.udlejningsomkostning).toLocaleString('da-DK') %> kr./md.
                        </p>
                        <p><strong>Årlig nettolejeindtægt:</strong>
                            <%= Number((u.maanedlig_leje - u.udlejningsomkostning) * 12).toLocaleString('da-DK') %>
                                kr./år
                        </p>
                        <% }) %>
                </div>
                <% } else { %>
                    <p style="color: #888;">Ingen udlejning angivet.</p>
                    <% } %>
        </section>

        <section>
            <h2>Simulering (30 år)</h2>
            <div style="position: relative; width: 100%;">
                <canvas id="simuleringChart"></canvas>
            </div>
            <div style="overflow-x: auto;">
                <table class="simulering-tabel">
                    <thead>
                        <tr>
                            <th>År</th>
                            <th>Cashflow (kr.)</th>
                            <th>Gæld (kr.)</th>
                            <th>Egenkapital (kr.)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% simulering.forEach(s=> { %>
                            <tr>
                                <!-- Cashflow-cellen farves rød hvis negativ, grøn hvis positiv via CSS-klasserne tal-negativ/tal-positiv -->
                                <td>
                                    <%= s.aar %>
                                </td>
                                <td class="<%= s.cashflow < 0 ? 'tal-negativ' : 'tal-positiv' %>">
                                    <%= s.cashflow.toLocaleString('da-DK') %>
                                </td>
                                <td>
                                    <%= s.gaeld.toLocaleString('da-DK') %>
                                </td>
                                <td>
                                    <%= s.egenkapital.toLocaleString('da-DK') %>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Chart.js er et JavaScript-bibliotek til at lave diagrammer.
     I stedet for at have biblioteket liggende i projektet selv,
     hentes det fra Cloudflares CDN - et globalt netværk af servere
     der leverer filen hurtigt uanset hvor brugeren befinder sig. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

    <script>

        // simData oprettes som et JavaScript-array i browseren ved hjælp af EJS og JSON.stringify.
        // Sådan fungerer det trin for trin:
        // 1. På SERVEREN kører EJS og finder rå-output-tagget og evaluerer det.
        // 2. JSON.stringify(simulering) konverterer server-arrayet 'simulering' til en JSON-streng,
        //    fx: [{"aar":1,"cashflow":-5000,"gaeld":2000000,"egenkapital":300000}, ...]
        // 3. Rå-output-tagget indsætter strengen uden HTML-escaping direkte i HTML-filen.
        //    //    Hvis man brugte escaped output i stedet, ville " blive til &quot; og JSON ville være ugyldig.
        // 4. Browseren modtager den færdige side og ser blot:
        //    const simData = [{"aar":1,...}, {"aar":2,...}];
        //    - altså helt almindelig JavaScript. EJS-taggene eksisterer ikke mere.
        //
        // De røde markeringer skyldes at VS Code's JavaScript-parser ikke forstår EJS-syntaks.
        // VS Code læser filen som ren JavaScript og ser rå-output-tagget som en ugyldig operator-kombination,
        // og "simulering" som en ukendt variabel (da den kun eksisterer på serveren, ikke i browseren).
        // Det er en falsk fejl (false positive) fra editoren - koden er 100% korrekt og
        // virker præcis som forventet når Node.js behandler filen.
        // prettier-ignore-kommentaren fortæller Prettier at lade denne del af koden uændret, da EJS-syntaksen kan forvirre formatteren og føre til utilsigtede ændringer i formateringen.
        // prettier-ignore
        const simData = <%- JSON.stringify(simulering) %>;

        // Lav labels til x-aksen - ét label per år (fx "År 1", "År 2" osv.)
        const labels = simData.map(s => 'År ' + s.aar);

        // Opret et nyt linjediagram i canvas-elementet
        new Chart(document.getElementById('simuleringChart').getContext('2d'), {
            type: 'line',
            data: {
                labels,
                datasets: [
                    // Cashflow - grøn linje
                    { label: 'Cashflow (kr.)', data: simData.map(s => s.cashflow), borderColor: '#2a7a3b', backgroundColor: 'rgba(42,122,59,0.08)', tension: 0.3 },
                    // Gæld - rød linje
                    { label: 'Gæld (kr.)', data: simData.map(s => s.gaeld), borderColor: '#c0392b', backgroundColor: 'rgba(192,57,43,0.08)', tension: 0.3 },
                    // Egenkapital - blå linje
                    { label: 'Egenkapital (kr.)', data: simData.map(s => s.egenkapital), borderColor: '#2a5caa', backgroundColor: 'rgba(42,92,170,0.08)', tension: 0.3 }
                ]
            },
            options: {
                responsive: true,        // Grafen tilpasser sig vinduets bredde
                maintainAspectRatio: true,
                plugins: { legend: { position: 'top' } }, // Forklaring vises øverst
                scales: {
                    y: {
                        ticks: {
                            // Formatér y-aksens tal med dansk tusindtalsseparator og kr. suffix
                            callback: v => v.toLocaleString('da-DK') + ' kr.'
                        }
                    }
                }
            }
        });
    </script>
</body>

</html>