<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Sammenlign cases</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <a href="/">← Tilbage til forsiden</a>
        <h1>Sammenlign investeringscases</h1>
        <p>Vælg to cases for at sammenligne deres simuleringsresultater</p>
    </header>

    <main>

        <%--=============================================VALGFORMULAR Brugeren vælger case A og case B via dropdowns.
            Formularen bruger method="GET" — det betyder at de valgte ID'er sendes i URL'en som ?id_a=X&id_b=Y i stedet
            for i req.body. Det gør det nemt at dele eller genindlæse siden med samme
            valg.=============================================--%>
            <section>
                <form method="GET" action="/sammenligning">
                    <div style="display: flex; gap: 2rem;">

                        <div style="flex: 1;">
                            <label>Case A</label>
                            <select name="id_a">
                                <option value="">— Vælg en case —</option>
                                <% // alleCases er arrayet fra routen med alle cases i systemet. // Vi looper igennem
                                    dem og laver én <option> per case.
                                    %>
                                    <% alleCases.forEach(c=> { %>
                                        <option value="<%= c.investeringscase_id %>" <% // Hvis denne case allerede er
                                            valgt (fra URL'en), // tilføjer vi 'selected' så dropdown husker valget //
                                            efter siden genindlæses med resultater. //==bruges (ikke===) fordi id_a er
                                            en streng fra URL'en // men c.investeringscase_id er et tal fra databasen.
                                            %>
                                            <%= id_a==c.investeringscase_id ? 'selected' : '' %>>
                                                <%= c.navn %> — <%= c.adresse %>
                                        </option>
                                        <% }) %>
                            </select>
                        </div>

                        <div style="flex: 1;">
                            <label>Case B</label>
                            <select name="id_b">
                                <option value="">— Vælg en case —</option>
                                <% alleCases.forEach(c=> { %>
                                    <option value="<%= c.investeringscase_id %>" <%=id_b==c.investeringscase_id
                                        ? 'selected' : '' %>>
                                        <%= c.navn %> — <%= c.adresse %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>

                    </div>
                    <button type="submit" style="margin-top: 1rem;">Sammenlign</button>
                </form>
            </section>

            <%-- SAMMENLIGNINGSRESULTAT Dette afsnit vises KUN hvis begge cases er valgt og hentet. caseA og caseB er
                null indtil brugeren har valgt begge. --%>
                <% if (caseA && caseB) { %>

                    <%--=============================================NØGLETAL SIDE OM SIDE Vi viser ejendomspris og
                        slutresultater (år 30) for begge cases i et to-kolonne
                        grid.=============================================--%>
                        <section>
                            <h2>Nøgletal</h2>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">

                                <div>
                                    <%-- caseA.sagen er selve investeringscase-rækken fra DB --%>
                                        <h2>
                                            <%= caseA.sagen.navn %>
                                        </h2>
                                        <div class="ejendom-data">
                                            <p>
                                                <strong>Ejendomspris:</strong>
                                                <% // toLocaleString('da-DK') formaterer tal med dansk //
                                                    tusindtalsseparator, fx 2500000 → "2.500.000" %>
                                                    <%= Number(caseA.sagen.ejendomspris).toLocaleString('da-DK') %> kr.
                                            </p>
                                            <p>
                                                <strong>Egenkapital år 30:</strong>
                                                <% // caseA.resultater er et array med ét objekt per år. // Vi bruger
                                                    .find() til at finde år 30 specifikt. %>
                                                    <%= caseA.resultater.find(s=> s.aar ===
                                                        30).egenkapital.toLocaleString('da-DK') %> kr.
                                            </p>
                                            <p>
                                                <strong>Cashflow år 30:</strong>
                                                <%= caseA.resultater.find(s=> s.aar ===
                                                    30).cashflow.toLocaleString('da-DK') %> kr.
                                            </p>
                                            <p>
                                                <strong>Gæld år 30:</strong>
                                                <%= caseA.resultater.find(s=> s.aar ===
                                                    30).gaeld.toLocaleString('da-DK') %> kr.
                                            </p>
                                        </div>
                                </div>

                                <div>
                                    <h2>
                                        <%= caseB.sagen.navn %>
                                    </h2>
                                    <div class="ejendom-data">
                                        <p>
                                            <strong>Ejendomspris:</strong>
                                            <%= Number(caseB.sagen.ejendomspris).toLocaleString('da-DK') %> kr.
                                        </p>
                                        <p>
                                            <strong>Egenkapital år 30:</strong>
                                            <%= caseB.resultater.find(s=> s.aar ===
                                                30).egenkapital.toLocaleString('da-DK') %> kr.
                                        </p>
                                        <p>
                                            <strong>Cashflow år 30:</strong>
                                            <%= caseB.resultater.find(s=> s.aar === 30).cashflow.toLocaleString('da-DK')
                                                %> kr.
                                        </p>
                                        <p>
                                            <strong>Gæld år 30:</strong>
                                            <%= caseB.resultater.find(s=> s.aar === 30).gaeld.toLocaleString('da-DK') %>
                                                kr.
                                        </p>
                                    </div>
                                </div>

                            </div>
                        </section>

                        <%--=============================================SAMMENLIGNING GRAF Vi viser egenkapital for
                            begge cases i én graf så brugeren direkte kan se forskellen over 30 år. Cashflow og gæld
                            kunne også tilføjes som ekstra datasets hvis man
                            vil.=============================================--%>
                            <section>
                                <h2>Egenkapital over 30 år</h2>
                                <canvas id="sammenligningChart"></canvas>
                            </section>

                            <% } %>

    </main>

    <%-- Chart.js hentes fra CDN — kun indlæst når begge cases er valgt --%>
        <% if (caseA && caseB) { %>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
            <script>
                // <%- JSON.stringify() %> sender server-arrays ned i browser-JS.
                // Vi bruger <%- (rå) i stedet for <%= (escaped) fordi JSON
                // indeholder tegn som { og " der ellers ville blive ødelagt.
                const dataA = <% - JSON.stringify(caseA.resultater) %>;
                const dataB = <% - JSON.stringify(caseB.resultater) %>;

                // X-aksen: "År 1", "År 2" ... "År 30"
                const labels = dataA.map(s => 'År ' + s.aar);

                new Chart(document.getElementById('sammenligningChart').getContext('2d'), {
                    type: 'line',
                    data: {
                        labels,
                        datasets: [
                            {
                                // EJS inde i JavaScript — henter casenavnet fra serveren
                                label: '<%= caseA.sagen.navn %> — Egenkapital',
                                data: dataA.map(s => s.egenkapital),
                                borderColor: '#2a5caa',
                                backgroundColor: 'rgba(42,92,170,0.08)',
                                tension: 0.3
                            },
                            {
                                label: '<%= caseB.sagen.navn %> — Egenkapital',
                                data: dataB.map(s => s.egenkapital),
                                borderColor: '#c0392b',
                                backgroundColor: 'rgba(192,57,43,0.08)',
                                tension: 0.3
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: 'top' } },
                        scales: {
                            y: {
                                ticks: {
                                    callback: v => v.toLocaleString('da-DK') + ' kr.'
                                }
                            }
                        }
                    }
                });
            </script>
            <% } %>

</body>

</html>