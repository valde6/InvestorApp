<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Ny investeringscase - Udlejning</title>
</head>
<body>

    <h1>Ny investeringscase</h1>
    <h2>Trin 5 af 5: Udlejning</h2>

    <form action="/investeringscases/ny/udlejning" method="POST">

        <!-- Skjult felt der sender investeringscase_id med til serveren via POST.
             Værdien sættes ind af EJS via <%= investeringscase_id %> som den modtager fra GET-routen.
             Brugeren ser ikke feltet, men det er nødvendigt for at vide hvilken case udlejningen tilhører. -->
        <input type="hidden" name="investeringscase_id" value="<%= investeringscase_id %>">

        <label>
            <!-- Checkbox styrer om udlejningsfelterne vises - håndteres af JavaScript i investeringscase-udlejning.js -->
            <input type="checkbox" id="udlejes-checkbox" name="udlejes" value="ja">
            Ejendommen skal udlejes
        </label>

        <!-- Skjult som standard - vises kun hvis brugeren sætter kryds i checkbox ovenfor -->
        <div id="udlejning-felter" style="display:none">
            <p>Tilføj udlejningsindtægter og udgifter.</p>

            <div id="udlejninger">
                <!-- Udlejningslinjer tilføjes her dynamisk af JavaScript i investeringscase-udlejning.js -->
            </div>

            <button type="button" id="tilfoej-udlejning">Tilføj udlejning</button>
        </div>

        <hr>

        <button type="submit">Afslut og se oversigt</button>

    </form>

    <script src="/js/investeringscase-udlejning.js"></script>
</body>
</html>