<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Ejendomsinvesterings-app</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <h1>Ejendomsinvesterings-app</h1>
        <p>Søg en adresse og analyser ejendommen som investering</p>
    </header>

    <main>
        <section class="soegning">
            <label for="adresse-input">Adresse:</label>

            <!-- autocomplete="off" forhindrer browseren i at vise tidligere søgninger som dropdown -->
            <input type="text" id="adresse-input" placeholder="Skriv en adresse, fx Solbjerg Plads" autocomplete="off">
            <ul id="forslag-liste"></ul>
        </section>

        <!-- Liste over tidligere oprettede ejendomsprofiler hentet fra databasen -->
        <section class="tidligere-ejendomme">
            <h2>Tidligere ejendomsprofiler</h2>

            <!-- Hvis ingen ejendomsprofiler findes vises en vejledende tekst i stedet for en tom liste -->
            <% if (ejendomme.length===0) { %>
                <p>Ingen ejendomsprofiler endnu. Søg en adresse ovenfor for at komme i gang.</p>
                <% } else { %>

                    <!-- Loop over alle ejendomsprofiler og vis dem som klikbare listepunkter -->
                    <ul class="ejendomme-liste">
                        <% ejendomme.forEach(function(ejendom) { %>
                            <li class="ejendom-item">
                                <a href="/ejendomsprofiler/<%= ejendom.ejendomsprofil_id %>">
                                    <strong>
                                        <%= ejendom.adresse %>
                                    </strong>
                                </a>
                                <span>
                                    <%= ejendom.ejendomstype %>
                                </span>

                                <!-- toLocaleDateString formaterer datoen til dansk format (dd.mm.åååå) -->
                                <span>Oprettet: <%= new Date(ejendom.oprettet_dato).toLocaleDateString('da-DK') %>
                                </span>
                                <span>Cases: <%= ejendom.antal_cases %></span>
                            </li>
                            <% }) %>
                    </ul>
                    <% } %>
        </section>

    </main>

    <script src="/js/sog.js"></script>
</body>

</html>