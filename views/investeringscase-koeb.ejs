<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/css/style.css">
    <title>Ny investeringscase - Køb</title>
</head>

<body>

    <h1>Ny investeringscase</h1>
    <h2>Trin 1 af 5: Køb og renoveringsudgifter</h2>

    <form action="/investeringscases/ny/koeb" method="POST">
        <label for="navn">Navn på investeringscase</label>
        <input type="text" id="navn" name="navn" required placeholder="fx Min lejlighed på Nørrebro">

        <h3>Obligatoriske udgifter</h3>

        <label for="ejendomspris">Ejendomspris (kr.)</label>
        <input type="number" id="ejendomspris" name="ejendomspris" required>

        <label for="omkostninger_koeb">Omkostninger ved køb (kr.)</label>
        <input type="number" id="omkostninger_koeb" name="omkostninger_koeb">

        <label for="advokat">Advokat (kr.)</label>
        <input type="number" id="advokat" name="advokat">

        <label for="tinglysning">Tinglysning (kr.)</label>
        <input type="number" id="tinglysning" name="tinglysning">

        <label for="koeberraadgivning">Køberrådgivning (kr.)</label>
        <input type="number" id="koeberraadgivning" name="koeberraadgivning">

        <h3>Ekstra udgifter</h3>
        <p>Tilføj eventuelle yderligere udgifter forbundet med købet.</p>

        <div id="ekstra-udgifter">
            <!-- Her bliver ekstra udgiftslinjer indsat dynamisk -->
        </div>

        <button type="button" id="tilfoej-udgift">Tilføj udgift</button>

        <hr>

        <button type="submit">Næste trin</button>

        <!-- Skjult felt der sender ejendomsprofil_id med når formularen submittes.
        Brugeren kan ikke se det, men POST-kaldet får id'et med -->
        <input type="hidden" name="ejendomsprofil_id" value="<%= ejendomsprofil_id %>">

    </form>

    <script src="/js/investeringscase-koeb.js"></script>
</body>

</html>