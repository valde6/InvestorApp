<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Ejendom</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <h1>Ejendom</h1>
        <a href="/">← Tilbage til søgning</a>
    </header>

    <main>
        <!-- BBR-data hentet via Datafordeler — byggeår, areal og værelser -->
        <section>
            <a href="/investeringscases/ny/koeb?ejendomsprofil_id=<%= ejendomsprofil_id %>">
                + Opret ny investeringscase
            </a>
            <h2>BBR Data</h2>
            <p><strong>Ejendomstype:</strong>
                <%= bygning.ejendomstype %>
            </p>
            <p><strong>Byggeår:</strong>
                <%= bygning.byg026Opførelsesår %>
            </p>
            <p><strong>Samlet areal:</strong> <!-- Boligareal for den specifikke enhed, altså et plan -->
                <%= bygning.byg038SamletBygningsareal %> m²
            </p>
            <p><strong>Antal etager:</strong>
                <%= bygning.byg054AntalEtager %>
            </p>
            <% if (enhed) { %>
                <p><strong>Boligareal:</strong> <!-- Boligareal for alle plan i bygningen -->
                    <%= enhed.enh026EnhedensSamledeAreal %> m²
                </p>
                <p><strong>Antal værelser:</strong>
                    <%= enhed.enh031AntalVærelser %>
                </p>
                <% } else { %>
                    <p>Ingen enhedsdata tilgængelig</p>
                    <% } %>
        </section>

        <section>
            <h2>Adresseinformation</h2>
            <h1>
                <%= adresse %>
            </h1>

            <!-- Viser et interaktivt luftfoto fra Skråfoto centreret om ejendommens koordinater -->
            <iframe src="<%= kortUrl %>" width="100%" height="400" frameborder="0"></iframe>
        </section>

        <section>
            <h2>Investeringscases</h2>
            <% if (cases.length> 0) { %>
                <% cases.forEach(c=> { %>
                    <p>
                        <!-- Link til case-oversigt — bruger query parameter id= som routen forventer -->
                        <a href="/oversigt?id=<%= c.investeringscase_id %>">
                            <%= c.navn %>
                        </a>

                    </p>
                    <% }) %>
                        <% } else { %>
                            <p>Ingen cases oprettet endnu.</p>
                            <% } %>
        </section>

    </main>
</body>

</html>