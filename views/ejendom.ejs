<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>Ejendom</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <h1>Ejendom</h1>
        <a href="/">← Tilbage til søgning</a>
    </header>

    <main>
        <!-- BBR-data hentet via Datafordeler — byggeår, areal og værelser -->
        <section>
            <!-- Formular der opretter ejendomsprofilen når brugeren aktivt vælger det.
     BBR-data sendes med som hidden inputs så POST-routen kan gemme dem i DB -->
            <form action="/ejendomme/<%= adresseId %>/opret" method="POST">

                <!-- Hidden inputs sender BBR-data med i POST-requesten uden at vise dem til brugeren.
                Dataen er allerede hentet fra BBR og ligger i EJS-variablerne — 
                vi pakker dem blot ind i formularen så routen kan gemme dem i databasen -->
                <input type="hidden" name="adresse" value="<%= adresse %>">
                <input type="hidden" name="ejendomstype" value="<%= bygning.byg021BygningensAnvendelse %>">
                <input type="hidden" name="byggeaar" value="<%= bygning.byg026Opførelsesår %>">
                <input type="hidden" name="boligareal_m2" value="<%= enhed?.enh026EnhedensSamledeAreal %>">
                <input type="hidden" name="antal_vaerelser" value="<%= enhed?.enh031AntalVærelser %>">

                <!-- ?? '' sikrer at grundareal sendes som tom streng frem for "null" hvis det ikke er hentet -->
                <input type="hidden" name="grundareal_m2" value="<%= grundareal ?? '' %>">
                <button type="submit">Opret ejendomsprofil</button>
            </form>
            <h2>BBR Data</h2>
            <p><strong>Ejendomstype:</strong>
                <%= bygning.ejendomstype %>
            </p>
            <p><strong>Byggeår:</strong>
                <%= bygning.byg026Opførelsesår %>
            </p>

            <!-- enhed kan være null i sjældne edge cases selv efter filtrering i ejendomme.js -->
            <% if (enhed) { %>
                <p><strong>Boligareal:</strong>
                    <%= enhed.enh026EnhedensSamledeAreal %> m²
                </p>
                <p><strong>Antal værelser:</strong>
                    <%= enhed.enh031AntalVærelser %>
                </p>
                <!-- Ekstra sikkerhedsnet så serveren ikke crasher ved ejs, selvom der er flere kontroller i ejendomme.js, kan det ske ved edgecases at der ikke er nogen enhed, selvom bygningen er registretet -->
                <% } else { %>
                    <p>Ingen enhedsdata tilgængelig</p>
                    <% } %>

                        <!-- Grundareal vises kun hvis det er hentet — det springes over for lejligheder -->
                        <% if (grundareal) { %>
                            <p><strong>Grundareal:</strong>
                                <%= grundareal %> m²
                            </p>
                            <% } %>
        </section>

        <section>
            <h2>Adresseinformation</h2>
            <h1>
                <%= adresse %>
            </h1>

            <!-- Viser et interaktivt luftfoto fra Skråfoto centreret om ejendommens koordinater -->
            <iframe src="<%= kortUrl %>" width="100%" height="400" frameborder="0"></iframe>
        </section>

    </main>
</body>

</html>