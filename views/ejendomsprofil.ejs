<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>
        <%= adresse %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <h1>Ejendomsprofil</h1>
        <a href="/">← Tilbage til forsiden</a>
    </header>

    <main>
        <section>
            <h2>
                <%= adresse %>
            </h2>
            <div class="ejendom-data">
                <p><strong>Ejendomstype:</strong> ...</p>
                <p><strong>Ejendomstype:</strong>
                    <%= profil.ejendomstype %>
                </p>
                <p><strong>Byggeår:</strong>
                    <%= profil.byggeaar %>
                </p>
                <p><strong>Boligareal:</strong>
                    <%= profil.boligareal_m2 %> m²
                </p>
                <p><strong>Antal værelser:</strong>
                    <%= profil.antal_vaerelser %>
                </p>
                <p><strong>Oprettet:</strong>
                    <%= new Date(profil.oprettet_dato).toLocaleDateString('da-DK') %>
                </p>
            </div>

        </section>

        <section>
            <div class="kortvisning">
                <iframe src="<%= kortUrl %>" width="100%" height="400" frameborder="0"></iframe>
            </div>

        </section>

        <section>
            <h2>Investeringscases</h2>
            <a href="/investeringscases/ny/koeb?ejendomsprofil_id=<%= profil.ejendomsprofil_id %>">
                <button>+ Opret ny investeringscase</button>
            </a>

            <% if (cases.length> 0) { %>
                <% cases.forEach(c=> { %>
                    <p>
                        <a href="/oversigt?id=<%= c.investeringscase_id %>">
                            <%= c.navn %>
                        </a>
                    </p>
                    <% }) %>
                        <% } else { %>
                            <p>Ingen cases oprettet endnu.</p>
                            <% } %>
        </section>
    </main>
</body>

</html>