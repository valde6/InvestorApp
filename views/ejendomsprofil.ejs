<!DOCTYPE html>
<html lang="da">

<head>
    <meta charset="UTF-8">
    <title>
        <%= adresse %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <header>
        <h1>Ejendomsprofil</h1>
        <a href="/">← Tilbage til forsiden</a>

        <!-- POST bruges til sletning da HTML-formularer kun understøtter GET og POST.
     action er dynamisk - ejendomsprofil_id sættes ind af EJS -->
        <form action="/ejendomsprofiler/<%= profil.ejendomsprofil_id %>/slet" method="POST" style="display:inline;">

            <!-- confirm() beder brugeren bekræfte inden sletning så data ikke slettes ved et uheld.
         ON DELETE CASCADE i databasen sørger for at alle tilknyttede cases også slettes -->
            <button type="submit" class="knap-slet"
                onclick="return confirm('Er du sikker? Dette sletter også alle tilknyttede investeringscases.')">
                Slet ejendomsprofil
            </button>
        </form>
    </header>

    <main>
        <section>
            <h2>
                <%= adresse %>
            </h2>
            <div class="ejendom-data">
                <p><strong>Ejendomstype:</strong>
                    <%= profil.ejendomstype %>
                </p>
                <p><strong>Byggeår:</strong>
                    <%= profil.byggeaar %>
                </p>
                <p><strong>Boligareal:</strong>
                    <%= profil.boligareal_m2 %> m²
                </p>
                <p><strong>Antal værelser:</strong>
                    <%= profil.antal_vaerelser %>
                </p>

                <!-- Grundareal vises kun hvis det er gemt - springes over for lejligheder -->
                <% if (profil.grundareal_m2) { %>
                    <p><strong>Grundareal:</strong>
                        <%= profil.grundareal_m2 %> m²
                    </p>
                    <% } %>
                        <p><strong>Oprettet:</strong>
                            <%= new Date(profil.oprettet_dato).toLocaleDateString('da-DK') %>
                        </p>
            </div>

        </section>

        <section>
            <div class="kortvisning">
                <iframe src="<%= kortUrl %>" width="100%" height="400" frameborder="0"></iframe>
            </div>

        </section>

        <section>
            <h2>Investeringscases</h2>

            <!-- ejendomsprofil_id sendes med i URL'en så routen ved hvilken profil den nye case skal knyttes til -->
            <a href="/investeringscases/ny/koeb?ejendomsprofil_id=<%= profil.ejendomsprofil_id %>">
                <button>+ Opret ny investeringscase</button>
            </a>
            <% if (cases.length> 0) { %>

                <!-- Loop over alle investeringscases tilknyttet denne profil -->
                <% cases.forEach(c=> { %>
                    <div class="case-item">
                        <a href="/investeringscase-oversigt?id=<%= c.investeringscase_id %>">
                            <%= c.navn %>
                        </a>
                        <div class="case-knapper">
                            <!-- Rediger-knap sender brugeren til redigeringsflowet for denne case -->
                            <a href="/investeringscases/<%= c.investeringscase_id %>/rediger/koeb">
                                <button class="knap-rediger">Rediger</button>
                            </a>

                            <!-- Dupliker sendes som POST da HTML ikke understøtter PUT direkte.
         Opretter en kopi af casen med alle tilknyttede data og nyt auto-genereret id -->
                            <form action="/investeringscases/<%= c.investeringscase_id %>/dupliker" method="POST">
                                <button type="submit" class="knap-dupliker">Dupliker</button>
                            </form>

                            <!-- Slet sendes som POST da HTML ikke understøtter DELETE direkte.
         confirm() beder brugeren bekræfte inden sletning så data ikke slettes ved et uheld.
         ON DELETE CASCADE i databasen sørger for at alt tilknyttet data også slettes -->
                            <form action="/investeringscases/<%= c.investeringscase_id %>/slet" method="POST">
                                <button type="submit" class="knap-slet"
                                    onclick="return confirm('Er du sikker på at du vil slette <%= c.navn %>?')">
                                    Slet
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <p>Ingen cases oprettet endnu.</p>
                            <% } %>
        </section>

        <section>
            <a href="/sammenligning" class="knap">Sammenlign cases</a>
        </section>
    </main>
</body>

</html>